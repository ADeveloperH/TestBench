  "testCases": [
    {
      "id": "no_crash",
      "name": "无崩溃",
      "description": "不应出现 Android 崩溃（FATAL EXCEPTION）",
      "scope": {
        "global": true,
        "apps": []
      },
      "group": "稳定性",
      "rules": [
        {
          "effect": "error",
          "description": "出现崩溃日志",
          "expr": {
            "kind": "group",
            "op": "and",
            "children": [
              {
                "kind": "cond",
                "cond": {
                  "field": "tag",
                  "op": "equals",
                  "value": "AndroidRuntime"
                }
              },
              {
                "kind": "cond",
                "cond": {
                  "field": "message",
                  "op": "contains",
                  "value": "FATAL EXCEPTION"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "no_anr",
      "name": "无 ANR",
      "description": "不应出现应用无响应（ANR）",
      "scope": {
        "global": true,
        "apps": []
      },
      "group": "稳定性",
      "rules": [
        {
          "effect": "error",
          "description": "出现 ANR",
          "expr": {
            "kind": "group",
            "op": "and",
            "children": [
              {
                "kind": "cond",
                "cond": {
                  "field": "tag",
                  "op": "equals",
                  "value": "ActivityManager"
                }
              },
              {
                "kind": "cond",
                "cond": {
                  "field": "message",
                  "op": "contains",
                  "value": "ANR in"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "any_error_log",
      "name": "出现错误级别日志",
      "description": "任何 error 级别（E）的日志都视为疑似问题，应关注排查",
      "scope": {
        "global": true,
        "apps": []
      },
      "group": "稳定性",
      "rules": [
        {
          "effect": "warn",
          "description": "出现 error 级别日志",
          "expr": {
            "kind": "cond",
            "cond": {
              "field": "level",
              "op": "equals",
              "value": "E"
            }
          }
        }
      ]
    },
    {
      "id": "network_error",
      "name": "网络响应异常",
      "description": "任一接口返回 result_code 不为 200 即视为异常",
      "scope": {
        "global": true,
        "apps": []
      },
      "group": "网络",
      "rules": [
        {
          "effect": "error",
          "description": "网络响应异常（result_code ≠ 200）",
          "expr": {
            "kind": "group",
            "op": "and",
            "children": [
              {
                "kind": "cond",
                "cond": {
                  "field": "tag",
                  "op": "equals",
                  "value": "Unity"
                }
              },
              {
                "kind": "cond",
                "cond": {
                  "field": "message",
                  "op": "contains",
                  "value": "NetWorkLog:Response"
                }
              },
              {
                "kind": "cond",
                "cond": {
                  "field": "message",
                  "op": "regex",
                  "value": "\"result_code\"\\s*:\\s*(?!200(?:\\D|$))\\d+"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "ie_sdk_init",
      "name": "激励框架初始化完成",
      "description": "哨兵：开始加载数据后 60 秒内应出现「所有SDK初始化完成」，未出现 = 初始化卡住或中断",
      "scope": {
        "global": true,
        "apps": []
      },
      "rules": [
        {
          "effect": "error",
          "description": "SDK 初始化未完成（缺失判定）",
          "expr": {
            "kind": "group",
            "op": "and",
            "children": [
              {
                "kind": "cond",
                "cond": {
                  "field": "tag",
                  "op": "equals",
                  "value": "Unity"
                }
              },
              {
                "kind": "cond",
                "cond": {
                  "field": "message",
                  "op": "contains",
                  "value": "所有SDK初始化完成"
                }
              }
            ]
          },
          "absence": {
            "anchor": {
              "kind": "group",
              "op": "and",
              "children": [
                {
                  "kind": "cond",
                  "cond": {
                    "field": "tag",
                    "op": "equals",
                    "value": "Unity"
                  }
                },
                {
                  "kind": "cond",
                  "cond": {
                    "field": "message",
                    "op": "contains",
                    "value": "开始加载全部数据"
                  }
                }
              ]
            },
            "withinSec": 60
          }
        }
      ],
      "group": "初始化"
    },
