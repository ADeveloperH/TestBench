# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 内置的 adb / scrcpy 二进制（由 scripts/bundle-binaries.sh 生成，不提交）
# 但目录本身提交 .gitkeep 占位，保证 tauri 构建时 bundle.resources 路径存在
src-tauri/bin/*
!src-tauri/bin/macos/
!src-tauri/bin/windows/
src-tauri/bin/macos/*
src-tauri/bin/windows/*
!src-tauri/bin/macos/.gitkeep
!src-tauri/bin/windows/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# updater 签名私钥（绝不提交，公钥已内置于 tauri.conf.json）
*.key
*.key.pem
*.private

# 本地发布产物（latest.json / 更新包）
release-output/

# pnpm 本地 store（依赖缓存）
.pnpm-store/
